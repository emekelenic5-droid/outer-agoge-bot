# OUTER AGOGE Bot — Environment Variables
# Fill these in on Railway (Variables tab)

# From @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID — makes you admin (get from @userinfobot)
ADMIN_IDS=your_telegram_user_id

# SQLite path — set to /app/outer_agoge.db after adding Railway volume
DB_PATH=outer_agoge.db
